APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/report_simplifier
# For a zero-setup local run you can omit DATABASE_URL entirely: SQLite is used.

# LLM: anthropic | openai | huggingface | mock   (mock = offline demo, output is NOT translated)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=            # for provider=openai: any OpenAI-compatible server (vLLM, Ollama, Together, ...)
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=1

# Independent second LLM pass that audits every generated explanation (strongly recommended)
JUDGE_ENABLED=true
JUDGE_FAIL_CLOSED=true

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./rag/index
MAX_UPLOAD_MB=15
ALLOWED_ORIGINS=http://localhost:8501
RETAIN_UPLOADS=false

OCR_ENGINE=tesseract
# Tesseract language packs to load. Report text is usually English; add scripts for bilingual reports.
OCR_LANGS=eng+hin+pan

# Frontend
API_BASE_URL=http://localhost:8000
